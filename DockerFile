FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS base
WORKDIR /app
EXPOSE 80
EXPOSE 443

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Copiamos la solución completa
COPY . .

# Restauramos y compilamos directamente especificando la solución
RUN dotnet restore "SolucionSistemaVenta.slnx"
RUN dotnet build "SolucionSistemaVenta.slnx" -c Release -o /app/build

FROM build AS publish
RUN dotnet publish "SistemaVenta.AplicacionWeb/SistemaVenta.AplicacionWeb.csproj" -c Release -o /app/publish /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "SistemaVenta.AplicacionWeb.dll"]
