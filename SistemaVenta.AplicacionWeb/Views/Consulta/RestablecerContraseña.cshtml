
@{
    ViewData["Title"] = "RestablecerContraseña";
    Layout = null;
}


<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Restablecer Contraseña - Mi Tienda</title>
    <!-- Importamos Bootstrap desde CDN seguro para que cargue al instante -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
            body {
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                height: 100vh;
                display: flex;
                justify-content: center;
                align-items: center;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            }

            .card-custom {
                background: #ffffff;
                border-radius: 1rem;
                box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
                padding: 2.5rem;
                width: 100%;
                max-width: 420px;
            }

            .btn-custom {
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                border: none;
                color: white;
                font-weight: 600;
                padding: 0.75rem;
                transition: all 0.3s ease;
            }

                .btn-custom:hover {
                    opacity: 0.9;
                    transform: translateY(-2px);
                    color: white;
                }
    </style>
</head>
<body>

    <div class="card-custom">
        <div class="text-center mb-4">
            <h3 class="fw-bold text-dark">Restablecer Clave</h3>
            <p class="text-muted small">Crea una nueva contraseña segura para tu cuenta.</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger text-center py-2 fs-6">@ViewBag.Error</div>
        }

        @if (ViewBag.Exito != null)
        {
            <div class="alert alert-success text-center py-3">
                <p class="mb-2 fw-semibold">@ViewBag.Exito</p>
                <a href="@Url.Action("Index", "Home")" class="btn btn-dark btn-sm w-100 mt-2">Ir al Inicio / Login</a>
            </div>
        }
        else
        {
            <form asp-action="RestablecerClave" method="post">
                <input type="hidden" name="userId" value="@ViewBag.UserId" />
                <input type="hidden" name="secret" value="@ViewBag.Secret" />

                <div class="mb-3">
                    <label class="form-label fw-semibold text-secondary">Nueva contraseña</label>
                    <input type="password" name="nuevaPassword" class="form-control" placeholder="Mínimo 8 caracteres" required />
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold text-secondary">Confirmar contraseña</label>
                    <input type="password" name="confirmarPassword" class="form-control" placeholder="Repite tu contraseña" required />
                </div>

                <button type="submit" class="btn btn-custom w-100 rounded-pill shadow-sm">Actualizar Contraseña</button>
            </form>
        }
    </div>

</body>
</html>